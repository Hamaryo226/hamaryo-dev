{
  "name": "hamaryo-content-local",
  "compatibility_date": "2026-07-07",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hamaryo-content-preview",
      "database_id": "00000000-0000-4000-8000-000000000001",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "hamaryo-media-preview" },
  ],
}
